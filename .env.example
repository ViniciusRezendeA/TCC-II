# GitHub Personal Access Token (fine-grained), read-only, public repositories scope.
# Used for both the GraphQL search API and (optionally) `git clone` over HTTPS if
# anonymous cloning gets throttled.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Etapa 3 (LLM-as-a-Judge) -- one key per juror provider in config/judges.yaml.
# Each SDK reads its own variable name directly; only the providers enabled in
# judges.yaml need a real value.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
