# GitHub Personal Access Token (fine-grained), read-only, public repositories scope.
# Used for both the GraphQL search API and (optionally) `git clone` over HTTPS if
# anonymous cloning gets throttled.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Etapa 3 (LLM-as-a-Judge) -- one key per juror provider in config/judges.yaml.
# Each SDK reads its own variable name directly; only the providers enabled in
# judges.yaml need a real value. Claude e GPT não são usados neste projeto.
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: scripts/run_parallel_step3.py roda a Etapa 3 em N processos, um por chave
# aqui (separadas por vírgula), cada um cobrindo sua própria partição do dataset -- não
# usado por run_step3.py diretamente. GOOGLE_API_KEY acima continua valendo para
# execuções normais (1 chave só).
GOOGLE_API_KEYS=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,AIzaSyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Local LLM servers (llama.cpp with OpenAI-compatible API)
# Format: http://IP:PORT/v1
LOCAL_LLM_BASE_URL=http://192.168.15.15:8090/v1
LOCAL_LLM_BEARER_TOKEN=540f4fe46b83cf4ca164287e914913bb
QWEN_LLM_BASE_URL=http://192.168.15.15:8092/v1
QWEN_LLM_BEARER_TOKEN=540f4fe46b83cf4ca164287e914913bb
