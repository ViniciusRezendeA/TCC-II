{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::wells_pe_criteria::mcp_servers/medcalc/medcalc/calculator.py:1601", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "wells_pe_criteria", "qualified_name": "wells_pe_criteria", "description": "Wells' Criteria for Pulmonary Embolism\n    Objectifies risk of pulmonary embolism based on clinical criteria.\n    Reference: Wells PS, et al. Thromb Haemost. 2000;83(3):416-20.\n    \n    Parameters:\n    -----------\n    clinical_signs_dvt: bool\n        Clinical signs and symptoms of DVT (leg swelling, pain with palpation)\n    alternative_diagnosis_less_likely: bool\n        Alternative diagnosis less likely than PE\n    heart_rate_over_100: bool\n        Heart rate > 100 beats per minute\n    immobilization_or_surgery: bool\n        Immobilization or surgery in the previous four weeks\n    previous_dvt_or_pe: bool\n        Previous DVT/PE\n    hemoptysis: bool\n        Hemoptysis\n    malignancy: bool\n        Malignancy (treatment ongoing, treated in last 6 months, or palliative)\n    \n    Returns:\n    --------\n    points: float\n        Total points based on Wells' criteria"}, "scenario": "with_source", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 25.185072446s.", "source_code_sha256": "7fe91b460d153699c718d3132bcb81df6a5767687c5b7bad31185b3a44833fe7", "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:34.892741+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::nihss_score::mcp_servers/medcalc/medcalc/calculator.py:1679", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "nihss_score", "qualified_name": "nihss_score", "description": "NIH Stroke Scale (NIHSS)\n    Quantifies stroke severity by assigning a score to various neurologic exam components.\n\n    Parameters:\n    -----------\n    Each parameter corresponds to an NIHSS item. All values must be integers within valid scoring ranges.\n\n    Returns:\n    --------\n    total_score: int\n        Total NIHSS score (0-42)"}, "scenario": "description_only", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 23.428749949s.", "source_code_sha256": null, "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:36.646899+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::nihss_score::mcp_servers/medcalc/medcalc/calculator.py:1679", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "nihss_score", "qualified_name": "nihss_score", "description": "NIH Stroke Scale (NIHSS)\n    Quantifies stroke severity by assigning a score to various neurologic exam components.\n\n    Parameters:\n    -----------\n    Each parameter corresponds to an NIHSS item. All values must be integers within valid scoring ranges.\n\n    Returns:\n    --------\n    total_score: int\n        Total NIHSS score (0-42)"}, "scenario": "with_source", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 22.336698543s.", "source_code_sha256": "2e6197361d66cbfeb77d42ba0b065be66e6b80c820a9537c3862c334b8bd0cda", "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:37.747198+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::ibw_calculator::mcp_servers/medcalc/medcalc/calculator.py:1746", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "ibw_calculator", "qualified_name": "ibw_calculator", "description": "Ideal Body Weight and Adjusted Body Weight Calculator\n    Calculates ideal body weight (Devine formula) and adjusted body weight.\n    \n    Parameters:\n    -----------\n    weight_kg : float\n        Actual body weight in kilograms\n    height_inches : float\n        Height in inches\n    male : bool\n        True if patient is male, False if female\n    \n    Returns:\n    --------\n    ibw: float\n        Ideal body weight in kilograms\n        \n    Formulas:\n    ---------\n    Ideal Body Weight (IBW) (Devine formula):\n    - Men: IBW = 50 kg + 2.3 kg × (height in inches - 60)\n    - Women: IBW = 45.5 kg + 2.3 kg × (height in inches - 60)\n    \n    Adjusted Body Weight (ABW):\n    - ABW = IBW + 0.4 × (actual weight - IBW)\n    \n    References:\n    -----------\n    Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8:650-655.\n    Pai MP. Drug Dosing Based on Weight and Body Surface Area: Mathematical Assumptions and Limitations in Obese Adults. Pharmacotherapy. 2012;32(9):856-868."}, "scenario": "description_only", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 20.51125511s.", "source_code_sha256": null, "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:39.572876+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::ibw_calculator::mcp_servers/medcalc/medcalc/calculator.py:1746", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "ibw_calculator", "qualified_name": "ibw_calculator", "description": "Ideal Body Weight and Adjusted Body Weight Calculator\n    Calculates ideal body weight (Devine formula) and adjusted body weight.\n    \n    Parameters:\n    -----------\n    weight_kg : float\n        Actual body weight in kilograms\n    height_inches : float\n        Height in inches\n    male : bool\n        True if patient is male, False if female\n    \n    Returns:\n    --------\n    ibw: float\n        Ideal body weight in kilograms\n        \n    Formulas:\n    ---------\n    Ideal Body Weight (IBW) (Devine formula):\n    - Men: IBW = 50 kg + 2.3 kg × (height in inches - 60)\n    - Women: IBW = 45.5 kg + 2.3 kg × (height in inches - 60)\n    \n    Adjusted Body Weight (ABW):\n    - ABW = IBW + 0.4 × (actual weight - IBW)\n    \n    References:\n    -----------\n    Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8:650-655.\n    Pai MP. Drug Dosing Based on Weight and Body Surface Area: Mathematical Assumptions and Limitations in Obese Adults. Pharmacotherapy. 2012;32(9):856-868."}, "scenario": "with_source", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 18.207272913s.", "source_code_sha256": "82599c58fa05b1af6b48dd63ea2062af6f851f95a2a2ec1a535ce45debfafd23", "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:41.973256+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::abw_calculator::mcp_servers/medcalc/medcalc/calculator.py:1826", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "abw_calculator", "qualified_name": "abw_calculator", "description": "Ideal Body Weight and Adjusted Body Weight Calculator\n    Calculates ideal body weight (Devine formula) and adjusted body weight.\n    \n    Parameters:\n    -----------\n    weight_kg : float\n        Actual body weight in kilograms\n    height_inches : float\n        Height in inches\n    male : bool\n        True if patient is male, False if female\n    \n    Returns:\n    --------\n    abw: float\n        Adjusted body weight in kilograms\n        \n    Formulas:\n    ---------\n    Ideal Body Weight (IBW) (Devine formula):\n    - Men: IBW = 50 kg + 2.3 kg × (height in inches - 60)\n    - Women: IBW = 45.5 kg + 2.3 kg × (height in inches - 60)\n    \n    Adjusted Body Weight (ABW):\n    - ABW = IBW + 0.4 × (actual weight - IBW)\n    \n    References:\n    -----------\n    Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8:650-655.\n    Pai MP. Drug Dosing Based on Weight and Body Surface Area: Mathematical Assumptions and Limitations in Obese Adults. Pharmacotherapy. 2012;32(9):856-868."}, "scenario": "description_only", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 17.00068309s.", "source_code_sha256": null, "usage": null, "latency_ms": null, "evaluated_at": "2026-09-09T22:04:43.078407+00:00"}
{"schema_version": "1.0", "prompt_version": "v2", "tool_uid": "Accenture/mcp-bench::abw_calculator::mcp_servers/medcalc/medcalc/calculator.py:1826", "repo": {"name_with_owner": "Accenture/mcp-bench", "stargazer_count": 502, "primary_language": "Python"}, "tool": {"name": "abw_calculator", "qualified_name": "abw_calculator", "description": "Ideal Body Weight and Adjusted Body Weight Calculator\n    Calculates ideal body weight (Devine formula) and adjusted body weight.\n    \n    Parameters:\n    -----------\n    weight_kg : float\n        Actual body weight in kilograms\n    height_inches : float\n        Height in inches\n    male : bool\n        True if patient is male, False if female\n    \n    Returns:\n    --------\n    abw: float\n        Adjusted body weight in kilograms\n        \n    Formulas:\n    ---------\n    Ideal Body Weight (IBW) (Devine formula):\n    - Men: IBW = 50 kg + 2.3 kg × (height in inches - 60)\n    - Women: IBW = 45.5 kg + 2.3 kg × (height in inches - 60)\n    \n    Adjusted Body Weight (ABW):\n    - ABW = IBW + 0.4 × (actual weight - IBW)\n    \n    References:\n    -----------\n    Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8:650-655.\n    Pai MP. Drug Dosing Based on Weight and Body Surface Area: Mathematical Assumptions and Limitations in Obese Adults. Pharmacotherapy. 2012;32(9):856-868."}, "scenario": "with_source", "judge": {"id": "gemini-3.5-flash-lite", "provider": "google", "model_id": "gemini-3.5-flash-lite", "raw_model_version": null}, "status": "error", "scores": null, "error_detail": "gemini API error 429: You exceeded your current quota, please check your plan and billing details. For more information on this error, head to: https://ai.google.dev/gemini-api/docs/rate-limits. To monitor your current usage, head to: https://ai.dev/rate-limit. \n* Quota exceeded for metric: generativelanguage.googleapis.com/generate_content_free_tier_requests, limit: 15, model: gemini-3.5-flash-lite\nPlease retry in 16.467339